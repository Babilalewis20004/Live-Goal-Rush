    {
      "id": 7,
      "type": "timeseries",
      "title": "Payment webhooks (accepted vs rejected)",
      "description": "Rejected = bad or stale signature. A sustained rise means someone is probing the endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
