# Production environment template (Phase 7).  Copy to `.env.production`, fill in, and keep it OUT of git
# (it is ignored).  Prefer injecting these from your platform's secret store.  Every value below that is
# marked REQUIRED makes `docker compose -f docker-compose.yml -f docker-compose.prod.yml` refuse to start
# when empty, and the API refuses to boot with ENVIRONMENT=production if a secret is weak or a URL is not
# https (apps/api/app/core/production_checks.py).
#
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# -- Public address (REQUIRED) -------------------------------------------------------------------
PUBLIC_HOST=livepitch.example
PUBLIC_ORIGIN=https://livepitch.example
PUBLIC_WS_ORIGIN=wss://livepitch.example

# -- Data stores (REQUIRED) ----------------------------------------------------------------------
POSTGRES_USER=football
POSTGRES_PASSWORD=
POSTGRES_DB=football_livescore
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# -- Authentication (REQUIRED) -------------------------------------------------------------------
JWT_SECRET=

# -- Football data provider (REQUIRED) -----------------------------------------------------------
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_API_KEY=

# -- Billing (REQUIRED) --------------------------------------------------------------------------
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
BILLING_WEBHOOK_SECRET=

# -- Media storage: an S3-compatible bucket (REQUIRED) ---------------------------------------------
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2/MinIO only; leave empty for AWS S3
S3_ENDPOINT_URL=
# Serve images from a CDN/public bucket instead of streaming through the API (optional)
MEDIA_PUBLIC_BASE_URL=

# -- Email: password-reset delivery (without it nobody can recover an account) -----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LivePitch <no-reply@livepitch.example>

# -- Push notifications (optional; web push stays off until both are set) ------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@livepitch.example

# -- Operations ------------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
CELERY_CONCURRENCY=2
HTTP_PORT=80
# Stamped into /version and logs by CI
APP_VERSION=
GIT_SHA=
