# Postgres (used by docker-compose; override POSTGRES_PORT if 5432 is
# already taken on your host)
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football_livescore
POSTGRES_PORT=5432

# Redis (used by docker-compose; override REDIS_PORT if 6379 is already
# taken on your host)
REDIS_PORT=6379

# Backend (apps/api) -- for running the API outside Docker, point
# DATABASE_URL/REDIS_URL at localhost instead of the "postgres"/"redis"
# service hostnames
DATABASE_URL=postgresql+asyncpg://football:football@localhost:5432/football_livescore
REDIS_URL=redis://localhost:6379/0
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_API_BASE_URL=
FOOTBALL_API_KEY=
# Phase 5: paid-plan features of the real provider, from: events,lineups,statistics
# (leave empty on the free tier -- they would just fail)
FOOTBALL_API_FEATURES=
# api-football only: comma separated league ids to expose (empty = built-in major leagues)
FOOTBALL_API_LEAGUE_IDS=39,140,135
# Comma-separated. Add Expo's dev ports (8081 Metro, 19006/3100 web export)
# alongside the web app's origin if you're also running apps/mobile locally.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Adaptive live-match polling / cache TTLs / WebSocket / retry config --
# see apps/api/.env.example for the full documented list and defaults.
LIVE_POLL_INTERVAL_SECONDS=30
UPCOMING_POLL_INTERVAL_SECONDS=60
POST_MATCH_SYNC_INTERVAL_SECONDS=60
REDIS_LIVE_MATCH_TTL_SECONDS=30
REDIS_DEFAULT_TTL_SECONDS=300
# Phase 4: near-immutable data (finished-match lineups/stats, squads, profiles)
REDIS_STATIC_TTL_SECONDS=3600
WEBSOCKET_HEARTBEAT_SECONDS=30
WEBSOCKET_MAX_CONNECTIONS=1000
SYNC_MAX_RETRIES=3
SYNC_BACKOFF_SECONDS=5

# Auth (Phase 3) -- see apps/api/.env.example for the full documented list.
# MUST be overridden with a real random secret outside local dev.
JWT_SECRET=dev-insecure-secret-change-me-before-deploying-anywhere-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5

# Push notifications (Phase 3) -- leave blank in dev to skip web push.
# apps/web fetches the public key live from GET /api/v1/notifications/
# vapid-public-key rather than needing its own copy of it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Discovery (Phase 5) -- see apps/api/.env.example for the documented list.
# Comma-separated CIDRs of proxies whose X-Forwarded-For is believed (the web
# container, a load balancer). Empty = never trust it.
TRUSTED_PROXY_CIDRS=
# Comma-separated hostnames article images may come from (empty = any http/https host)
ARTICLE_IMAGE_ALLOWED_HOSTS=
CONTENT_NOTIFICATION_DAILY_CAP=3
TRENDING_WINDOW_HOURS=24
TRENDING_HALF_LIFE_HOURS=6

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the BROWSER reaches the API for client-side calls. Only needs setting when
# it differs from NEXT_PUBLIC_API_URL (e.g. Docker, where the server uses http://api:8000).
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8000
# Canonical origin for SEO (canonical links, Open Graph, sitemap) -- set to the real public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The browser opens this directly (not through the Docker network), so it
# always points at the host machine.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Mobile (apps/mobile) -- the mobile app never talks to the football
# provider directly, only to this same backend
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# Phase 6 -- media storage (MinIO locally), monitoring
MEDIA_STORAGE_BACKEND=s3
S3_ACCESS_KEY=livepitch
S3_SECRET_KEY=livepitch-secret
S3_BUCKET=livepitch-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# How browsers/phones reach the API (image links are built from this).
PUBLIC_API_URL=http://localhost:8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# change outside local development
GRAFANA_ADMIN_PASSWORD=admin
LOG_FORMAT=json

# Phase 6b -- billing. `test` provider is for development only (refused when ENVIRONMENT=production).
ENVIRONMENT=development
BILLING_PROVIDER=test
BILLING_WEBHOOK_SECRET=dev-only-webhook-secret
STRIPE_SECRET_KEY=
ADS_ENABLED=false

# Phase 7 -- production hardening. Production uses .env.production (see .env.production.example), NOT this file.
# Uvicorn workers per API container (one per CPU core is the usual starting point)
WEB_CONCURRENCY=1
# Per-process database pool (see apps/api/.env.example)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Sockets one client address may hold open
WEBSOCKET_MAX_CONNECTIONS_PER_IP=25
# Optional: image tag to run instead of building (release overlay / CI)
# API_IMAGE=
