ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://football:football@localhost:5432/football_livescore
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_API_BASE_URL=
FOOTBALL_API_KEY=
# Phase 5: paid-plan features of the real provider, from: events,lineups,statistics
FOOTBALL_API_FEATURES=
# api-football only: comma separated league ids to expose (empty = built-in major leagues)
FOOTBALL_API_LEAGUE_IDS=39,140,135
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Redis (Phase 2) -- cache-aside reads + Pub/Sub between the worker and the
# WebSocket layer. Point at "redis" (the Docker Compose service name) when
# running in Docker, "localhost" when running the API outside it.
REDIS_URL=redis://localhost:6379/0

# Adaptive live-match polling (see docs/architecture/realtime.md). The
# worker re-syncs LIVE/HALFTIME matches this often:
LIVE_POLL_INTERVAL_SECONDS=30
# ...matches within 15 minutes of kickoff (in case they've gone live) or
# recently finished (in case of a late provider correction) this often:
UPCOMING_POLL_INTERVAL_SECONDS=60
POST_MATCH_SYNC_INTERVAL_SECONDS=60

# Cache TTLs (see docs/architecture/caching.md). Live match/detail data:
REDIS_LIVE_MATCH_TTL_SECONDS=30
# Slower-moving data (today/upcoming fixtures, standings, team fixtures):
REDIS_DEFAULT_TTL_SECONDS=300
# Phase 4: near-immutable data (finished-match lineups/stats, squads, profiles)
REDIS_STATIC_TTL_SECONDS=3600

# WebSockets
WEBSOCKET_HEARTBEAT_SECONDS=30
WEBSOCKET_MAX_CONNECTIONS=1000

# Provider sync retry/backoff (exponential: SYNC_BACKOFF_SECONDS * 2^attempt)
SYNC_MAX_RETRIES=3
SYNC_BACKOFF_SECONDS=5


# -- Auth (Phase 3, see docs/architecture/auth.md) ---------------------------
# Signs/verifies access tokens. MUST be overridden with a real random
# secret outside local dev -- this placeholder is intentionally public.
JWT_SECRET=dev-insecure-secret-change-me-before-deploying-anywhere-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Redis-backed fixed-window rate limits (see core/rate_limit.py)
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5

# -- Push notifications (Phase 3, see docs/architecture/notifications.md) ---
# Web push (VAPID). Generate a real keypair locally, e.g.:
#   python -c "from pywebpush import webpush; from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# Leave blank in dev to simply skip web push registration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -- Discovery: news, search, trending, personalisation (docs/architecture/discovery.md)
# Hostnames article images may come from, comma separated. Empty = any http(s) host
# (images are only linked, never fetched by the server).
ARTICLE_IMAGE_ALLOWED_HOSTS=
# Public article lists/details and the discovery home are cached this long; any
# content change invalidates them immediately (a version number, not a TTL wait).
ARTICLE_CACHE_TTL_SECONDS=120
DISCOVERY_CACHE_TTL_SECONDS=120
# Trending: window, exponential-decay half-life, and how long the precomputed
# lists (refreshed every 5 minutes by the scheduler) stay valid.
TRENDING_WINDOW_HOURS=24
TRENDING_HALF_LIFE_HOURS=6
TRENDING_CACHE_TTL_SECONDS=900
# Per-user personalised feed cache.
FEED_CACHE_TTL_SECONDS=45
# The same visitor re-opening the same page within this window counts once.
VIEW_DEDUP_SECONDS=1800
# Per-client-IP limits, per minute.
SEARCH_RATE_LIMIT_PER_MINUTE=60
TRACK_RATE_LIMIT_PER_MINUTE=120
# At most this many article pushes per user per UTC day.
CONTENT_NOTIFICATION_DAILY_CAP=3
# A search phrase is only listed as "popular" after this many different visitors
# picked a result for it.
POPULAR_SEARCH_MIN_VIEWERS=3
# CIDR ranges of reverse proxies / the web server whose X-Forwarded-For is
# believed, so rate limits count real visitors. Empty = never trust the header.
TRUSTED_PROXY_CIDRS=

# -- Media (Phase 6, docs/architecture/media.md) -----------------------------------
# "local" stores images in MEDIA_LOCAL_ROOT; "s3" uses Amazon S3, Cloudflare R2 or MinIO.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=./media-data
S3_BUCKET=livepitch-media
# MinIO: http://localhost:9000 ; Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Serve images straight from a CDN / public bucket instead of through the API (optional).
MEDIA_PUBLIC_BASE_URL=
# How clients reach this API; image URLs are built from it.
PUBLIC_API_URL=http://localhost:8000
MEDIA_MAX_BYTES=5242880
MEDIA_MIN_SIDE=64
MEDIA_MAX_SIDE=8000
MEDIA_MAX_PIXELS=40000000
MEDIA_UPLOADS_PER_MINUTE=20
MEDIA_UPLOADS_PER_DAY=200

# -- Community (Phase 6, docs/architecture/community.md) ---------------------------
COMMENT_MAX_LENGTH=2000
COMMENT_MAX_LINKS=2
COMMENTS_PER_MINUTE=5
COMMENTS_PER_HOUR=40
COMMENT_AUTO_HIDE_REPORTS=3
REACTIONS_PER_MINUTE=30
POLL_VOTES_PER_MINUTE=20

# -- Logging (Phase 6, docs/architecture/observability.md) -------------------------
# json | text
LOG_FORMAT=json
LOG_LEVEL=INFO
SERVICE_NAME=api

# -- Analytics, predictions and billing (Phase 6b, docs/architecture/monetisation.md) ----------
ANALYTICS_CACHE_TTL_SECONDS=900
PREDICTION_CACHE_TTL_SECONDS=300
PREDICTION_HORIZON_HOURS=72
# test | stripe. `test` is for development and the test suite and is refused when ENVIRONMENT=production.
BILLING_PROVIDER=test
# Shared secret that signs payment webhooks. MUST be changed (and be long and random) outside development.
BILLING_WEBHOOK_SECRET=dev-only-webhook-secret
STRIPE_SECRET_KEY=
BILLING_SUCCESS_URL=http://localhost:3000/premium?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/premium?checkout=cancelled
BILLING_GRACE_DAYS=3
CHECKOUT_PER_HOUR=10
WEBHOOK_PER_MINUTE=120
PROFILE_REPORTS_PER_HOUR=10
# Reserve labelled ad slots (no ad network or tracking is built in)
ADS_ENABLED=false

# -- Production hardening (Phase 7; docs/deployment/environments.md) -----------------------------
# development | test | staging | production. staging/production REFUSE TO START on an unsafe configuration
# (weak JWT_SECRET, wildcard CORS, test billing provider, default passwords, ...) -- see app/core/production_checks.py.
ENVIRONMENT=development
APP_VERSION=2.1.0
GIT_SHA=
# Comma separated Host headers the API answers to ("*" = any). Required in production.
ALLOWED_HOSTS=*
# Requests with a larger body are refused with 413 (image uploads get media max + this).
MAX_REQUEST_BODY_BYTES=1048576
# Database pool, PER PROCESS: connections used ~ (DB_POOL_SIZE + DB_MAX_OVERFLOW) x (uvicorn workers + celery processes)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
# Celery: a hung task is stopped at the soft limit and killed at the hard one (the hard limit also bounds redelivery after a worker dies)
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=240
CELERY_TASK_TIME_LIMIT_SECONDS=300
# WebSockets: a client that cannot take a message within the send timeout is dropped; one address may hold this many sockets
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
WEBSOCKET_MAX_CONNECTIONS_PER_IP=25
# Unified search results are cached this long (they can include scores)
SEARCH_RESULTS_CACHE_TTL_SECONDS=30
# Searches matching nothing stored may ask the football provider, all clients together, per minute
SEARCH_PROVIDER_FALLBACKS_PER_MINUTE=10
# Email (password-reset delivery). Without SMTP_HOST a deployed instance cannot send reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LivePitch <no-reply@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false
# Origin of the web app: the base of links sent in email
PUBLIC_SITE_URL=http://localhost:3000
